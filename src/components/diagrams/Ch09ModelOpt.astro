<svg viewBox="0 0 720 440" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Model-level inference optimization techniques">
  <text x="360" y="28" font-size="13.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Model-level optimization attacks the three transformer cost centers</text>

  <!-- size -->
  <rect x="40" y="48" width="205" height="180" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="142" y="74" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Model size</text>
  <text x="142" y="92" font-size="10" text-anchor="middle" fill="var(--ink-faint)">→ compression</text>
  <text x="54" y="116" font-size="10.5" fill="var(--ink-soft)">· quantization — fewer bits;</text>
  <text x="62" y="132" font-size="10.5" fill="var(--ink-soft)">easy, effective, most popular</text>
  <text x="54" y="152" font-size="10.5" fill="var(--ink-soft)">· distillation — small student</text>
  <text x="62" y="168" font-size="10.5" fill="var(--ink-soft)">mimics big teacher</text>
  <text x="54" y="188" font-size="10.5" fill="var(--ink-soft)">· pruning — zero out / remove</text>
  <text x="62" y="204" font-size="10.5" fill="var(--ink-soft)">unhelpful params; rarer in practice</text>

  <!-- autoregressive decoding -->
  <rect x="258" y="48" width="205" height="180" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="360" y="74" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Autoregressive decoding</text>
  <text x="360" y="92" font-size="10" text-anchor="middle" fill="var(--ink-faint)">one token at a time = slow + pricey</text>
  <text x="272" y="116" font-size="10.5" fill="var(--ink-soft)">· speculative decoding — draft</text>
  <text x="280" y="132" font-size="10.5" fill="var(--ink-soft)">model proposes, target verifies</text>
  <text x="280" y="148" font-size="10.5" fill="var(--ink-soft)">in parallel (free idle FLOPs)</text>
  <text x="272" y="168" font-size="10.5" fill="var(--ink-soft)">· inference w/ reference — copy</text>
  <text x="280" y="184" font-size="10.5" fill="var(--ink-soft)">draft tokens from the input</text>
  <text x="272" y="204" font-size="10.5" fill="var(--ink-soft)">· parallel decoding — Lookahead,</text>
  <text x="280" y="220" font-size="10.5" fill="var(--ink-soft)">Medusa heads + verification</text>

  <!-- attention -->
  <rect x="476" y="48" width="205" height="180" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="578" y="74" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Attention &amp; KV cache</text>
  <text x="578" y="92" font-size="10" text-anchor="middle" fill="var(--ink-faint)">the long-context tax</text>
  <text x="490" y="116" font-size="10.5" fill="var(--ink-soft)">· redesign: local windowed,</text>
  <text x="498" y="132" font-size="10.5" fill="var(--ink-soft)">multi-/grouped-query, cross-layer</text>
  <text x="498" y="148" font-size="10.5" fill="var(--ink-soft)">(20× KV reduction in production)</text>
  <text x="490" y="168" font-size="10.5" fill="var(--ink-soft)">· manage: PagedAttention (vLLM),</text>
  <text x="498" y="184" font-size="10.5" fill="var(--ink-soft)">cache quantization/compression</text>
  <text x="490" y="204" font-size="10.5" fill="var(--ink-soft)">· kernels: FlashAttention —</text>
  <text x="498" y="220" font-size="10.5" fill="var(--ink-soft)">fused ops, hardware-specific</text>

  <!-- KV cache math -->
  <rect x="40" y="248" width="640" height="64" rx="10" fill="var(--bg-raised)" stroke="var(--line)" />
  <text x="58" y="272" font-size="11.5" font-weight="600" fill="var(--ink)">KV cache math: 2 × batch × seq-length × layers × model-dim × bytes</text>
  <text x="58" y="292" font-size="10.5" fill="var(--ink-soft)">13B-class model, batch 32, 2,048 context, FP16 → ~54 GB of cache · at 500B-scale it can reach 3 TB — triple the weights</text>

  <!-- speculative decoding flow -->
  <rect x="40" y="328" width="640" height="92" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="58" y="352" font-size="11.5" font-weight="600" fill="var(--accent-ink)">Speculative decoding in one line</text>
  <text x="58" y="372" font-size="10.5" fill="var(--ink-soft)">small draft model writes K tokens → big model verifies all K in parallel (verification ≈ prefill, cheap) → accept the agreeing</text>
  <text x="58" y="390" font-size="10.5" fill="var(--ink-soft)">prefix + one real token → repeat · easy tokens are predictable, so acceptance is high (more so for code) ·</text>
  <text x="58" y="408" font-size="10.5" fill="var(--ink-soft)">halved latency with zero quality change in published results — now standard in vLLM, TensorRT-LLM, llama.cpp</text>
</svg>
