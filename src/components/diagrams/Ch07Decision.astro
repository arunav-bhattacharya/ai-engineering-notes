<svg viewBox="0 0 720 440" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Adaptation decision flow: prompting, RAG, finetuning">
  <defs>
    <marker id="ch07dec-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <rect x="235" y="16" width="250" height="50" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="360" y="38" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">1 · Prompt engineering</text>
  <text x="360" y="56" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">best practices, versioned, systematic</text>

  <line x1="360" y1="66" x2="360" y2="92" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch07dec-arrow)" />

  <rect x="235" y="98" width="250" height="50" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="360" y="120" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">2 · Add examples (1–50 shots)</text>
  <text x="360" y="138" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">still failing? diagnose the failure type</text>

  <!-- branch -->
  <line x1="360" y1="148" x2="360" y2="170" stroke="var(--ink-faint)" stroke-width="1.5" />
  <line x1="180" y1="170" x2="540" y2="170" stroke="var(--ink-faint)" stroke-width="1.5" />
  <line x1="180" y1="170" x2="180" y2="192" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch07dec-arrow)" />
  <line x1="540" y1="170" x2="540" y2="192" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch07dec-arrow)" />

  <text x="170" y="186" font-size="11" font-weight="600" text-anchor="end" fill="var(--accent)">information-based failures</text>
  <text x="550" y="186" font-size="11" font-weight="600" text-anchor="start" fill="var(--warn-ink)">behavior-based failures</text>

  <rect x="40" y="198" width="280" height="92" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="180" y="222" font-size="13" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">3a · RAG — facts</text>
  <text x="180" y="242" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">wrong/outdated/missing information</text>
  <text x="180" y="259" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">start with term-based (BM25), then</text>
  <text x="180" y="275" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">embedding-based / hybrid retrieval</text>

  <rect x="400" y="198" width="280" height="92" rx="10" fill="var(--warn-soft)" stroke="var(--warn-ink)" />
  <text x="540" y="222" font-size="13" font-weight="600" text-anchor="middle" fill="var(--warn-ink)">3b · Finetuning — form</text>
  <text x="540" y="242" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">irrelevant style, broken formats,</text>
  <text x="540" y="259" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">unusual syntaxes (rare SQL dialects,</text>
  <text x="540" y="275" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">domain-specific languages)</text>

  <line x1="180" y1="290" x2="180" y2="314" stroke="var(--ink-faint)" stroke-width="1.5" />
  <line x1="540" y1="290" x2="540" y2="314" stroke="var(--ink-faint)" stroke-width="1.5" />
  <line x1="180" y1="314" x2="540" y2="314" stroke="var(--ink-faint)" stroke-width="1.5" />
  <line x1="360" y1="314" x2="360" y2="336" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch07dec-arrow)" />

  <rect x="235" y="342" width="250" height="50" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="360" y="364" font-size="13" font-weight="600" text-anchor="middle" fill="var(--ink)">4 · Combine RAG + finetuning</text>
  <text x="360" y="382" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">when neither alone is enough</text>

  <text x="360" y="424" font-size="12" font-style="italic" text-anchor="middle" fill="var(--ink-soft)">Define your evaluation pipeline BEFORE step 1 — it benchmarks every step. RAG first when in doubt: it's easier and often gains more.</text>
</svg>
