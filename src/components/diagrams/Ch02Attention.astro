<svg viewBox="0 0 720 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The attention mechanism as a library lookup">
  <defs>
    <marker id="ch02at-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
    </marker>
    <marker id="ch02at-faint" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <!-- query box on the left -->
  <rect x="30" y="130" width="180" height="78" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <text x="120" y="160" font-size="14" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">Query (Q)</text>
  <text x="120" y="180" font-size="11" text-anchor="middle" fill="var(--ink-soft)">“what am I looking for</text>
  <text x="120" y="195" font-size="11" text-anchor="middle" fill="var(--ink-soft)">right now?”</text>

  <!-- bus from query to a vertical rail -->
  <line x1="210" y1="169" x2="260" y2="169" stroke="var(--accent)" stroke-width="1.5" />
  <line x1="260" y1="60" x2="260" y2="276" stroke="var(--accent)" stroke-width="1.5" />

  <!-- horizontal arrows into each token card, labels ABOVE each arrow -->
  <line x1="260" y1="60" x2="352" y2="60" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch02at-arrow)" />
  <text x="306" y="48" font-size="11" text-anchor="middle" fill="var(--accent-ink)">Q·K score 0.1</text>

  <line x1="260" y1="168" x2="352" y2="168" stroke="var(--accent)" stroke-width="3" marker-end="url(#ch02at-arrow)" />
  <text x="306" y="156" font-size="11" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">Q·K score 0.7</text>

  <line x1="260" y1="276" x2="352" y2="276" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch02at-arrow)" />
  <text x="306" y="264" font-size="11" text-anchor="middle" fill="var(--accent-ink)">Q·K score 0.2</text>

  <!-- token cards (keys + values) -->
  <g text-anchor="middle">
    <rect x="356" y="24" width="210" height="72" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="461" y="52" font-size="12.5" font-weight="600" fill="var(--ink)">token “How”</text>
    <text x="461" y="74" font-size="10" fill="var(--ink-soft)">key = page number · value = content</text>

    <rect x="356" y="132" width="210" height="72" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="461" y="160" font-size="12.5" font-weight="600" fill="var(--ink)">token “are”</text>
    <text x="461" y="182" font-size="10" fill="var(--ink-soft)">key · value</text>

    <rect x="356" y="240" width="210" height="72" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="461" y="268" font-size="12.5" font-weight="600" fill="var(--ink)">token “you”</text>
    <text x="461" y="290" font-size="10" fill="var(--ink-soft)">key · value</text>
  </g>

  <!-- weighted sum collector rail on the right -->
  <line x1="570" y1="60" x2="600" y2="60" stroke="var(--ink-faint)" stroke-width="1" />
  <line x1="570" y1="168" x2="600" y2="168" stroke="var(--ink-faint)" stroke-width="2.5" />
  <line x1="570" y1="276" x2="600" y2="276" stroke="var(--ink-faint)" stroke-width="1" />
  <line x1="600" y1="60" x2="600" y2="276" stroke="var(--ink-faint)" stroke-width="1" />
  <line x1="600" y1="168" x2="614" y2="168" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch02at-faint)" />

  <rect x="620" y="132" width="86" height="72" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <text x="663" y="160" font-size="12" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">weighted</text>
  <text x="663" y="177" font-size="12" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">sum of V</text>

  <text x="360" y="348" font-size="12" font-style="italic" text-anchor="middle" fill="var(--ink-soft)">High Q·K score → that token’s value contributes more to the next-token prediction.</text>
  <text x="360" y="366" font-size="12" font-style="italic" text-anchor="middle" fill="var(--ink-soft)">Thicker arrows = more attention.</text>
</svg>
