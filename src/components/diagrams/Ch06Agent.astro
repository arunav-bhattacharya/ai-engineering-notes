<svg viewBox="0 0 720 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The agent loop: plan, validate, execute with tools, reflect">
  <defs>
    <marker id="ch06ag-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
    <marker id="ch06ag-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
    </marker>
  </defs>

  <!-- task in -->
  <rect x="40" y="20" width="200" height="50" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="140" y="42" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">Task = goal + constraints</text>
  <text x="140" y="60" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">“2-week SF→India trip, $5,000”</text>

  <line x1="140" y1="70" x2="140" y2="100" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06ag-arrow)" />

  <!-- plan -->
  <rect x="40" y="106" width="200" height="64" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="140" y="130" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">1 · Generate plan</text>
  <text x="140" y="148" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">decompose into actions</text>
  <text x="140" y="163" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">(intent classifier helps pick tools)</text>

  <line x1="244" y1="138" x2="296" y2="138" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06ag-arrow)" />

  <!-- validate -->
  <rect x="302" y="106" width="200" height="64" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="402" y="130" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">2 · Validate plan</text>
  <text x="402" y="148" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">heuristics (valid tools? ≤ N steps?)</text>
  <text x="402" y="163" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">or AI judge — bad plan → replan</text>

  <line x1="506" y1="138" x2="558" y2="138" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06ag-arrow)" />

  <!-- execute -->
  <rect x="564" y="106" width="116" height="64" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="622" y="130" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">3 · Execute</text>
  <text x="622" y="148" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">function calling</text>
  <text x="622" y="163" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">invokes tools</text>

  <!-- reflect -->
  <line x1="622" y1="170" x2="622" y2="206" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch06ag-accent)" />
  <rect x="302" y="212" width="378" height="60" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="491" y="236" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--ink)">4 · Reflect on outcomes (ReAct / Reflexion)</text>
  <text x="491" y="256" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">on track? goal accomplished? errors → analyze, correct, replan</text>

  <path d="M 298 242 C 180 242, 140 220, 140 176" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch06ag-accent)" />
  <text x="180" y="216" font-size="10.5" font-style="italic" fill="var(--accent)">loop until done</text>

  <!-- tools -->
  <text x="40" y="312" font-size="13" font-weight="600" fill="var(--ink)">Tool inventory (read actions perceive · write actions change the world)</text>
  <g font-size="10.5">
    <rect x="40" y="324" width="205" height="92" rx="9" fill="var(--bg-raised)" stroke="var(--line)" />
    <text x="142" y="346" font-size="11.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Knowledge augmentation</text>
    <text x="142" y="366" text-anchor="middle" fill="var(--ink-soft)">retrievers, SQL executor,</text>
    <text x="142" y="382" text-anchor="middle" fill="var(--ink-soft)">web search, email reader —</text>
    <text x="142" y="398" text-anchor="middle" fill="var(--ink-soft)">keeps the model from going stale</text>

    <rect x="258" y="324" width="205" height="92" rx="9" fill="var(--bg-raised)" stroke="var(--line)" />
    <text x="360" y="346" font-size="11.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Capability extension</text>
    <text x="360" y="366" text-anchor="middle" fill="var(--ink-soft)">calculator, code interpreter,</text>
    <text x="360" y="382" text-anchor="middle" fill="var(--ink-soft)">translator, image generator —</text>
    <text x="360" y="398" text-anchor="middle" fill="var(--ink-soft)">patches model weaknesses cheaply</text>

    <rect x="476" y="324" width="205" height="92" rx="9" fill="var(--bg-raised)" stroke="var(--bad-ink)" stroke-dasharray="5 4" />
    <text x="578" y="346" font-size="11.5" font-weight="600" text-anchor="middle" fill="var(--ink)">Write actions ⚠</text>
    <text x="578" y="366" text-anchor="middle" fill="var(--ink-soft)">send email, update DB, transfer</text>
    <text x="578" y="382" text-anchor="middle" fill="var(--ink-soft)">money — full automation, real risk:</text>
    <text x="578" y="398" text-anchor="middle" fill="var(--ink-soft)">gate with approvals &amp; sandboxes</text>
  </g>

  <text x="360" y="446" font-size="12" font-style="italic" text-anchor="middle" fill="var(--ink-soft)">Compound error math: 95% per-step accuracy → 60% over 10 steps, 0.6% over 100. Agents need strong models.</text>
</svg>
