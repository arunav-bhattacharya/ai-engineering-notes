<svg viewBox="0 0 720 430" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RAG architecture: indexing path and query path">
  <defs>
    <marker id="ch06rag-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <!-- indexing path -->
  <text x="40" y="32" font-size="13" font-weight="600" fill="var(--ink)">Indexing (ahead of time)</text>

  <rect x="40" y="44" width="150" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="115" y="67" font-size="12" text-anchor="middle" fill="var(--ink)">Documents</text>
  <text x="115" y="85" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">memos, wikis, PDFs…</text>

  <line x1="194" y1="71" x2="240" y2="71" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06rag-arrow)" />
  <text x="217" y="62" font-size="10" text-anchor="middle" fill="var(--accent)">chunk</text>

  <rect x="246" y="44" width="150" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="321" y="67" font-size="12" text-anchor="middle" fill="var(--ink)">Chunks</text>
  <text x="321" y="85" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">+ optional context/metadata</text>

  <line x1="400" y1="71" x2="446" y2="71" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06rag-arrow)" />
  <text x="423" y="62" font-size="10" text-anchor="middle" fill="var(--accent)">embed / index</text>

  <rect x="452" y="44" width="228" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="566" y="67" font-size="12" text-anchor="middle" fill="var(--ink)">Index</text>
  <text x="566" y="85" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">inverted index (terms) or vector DB (embeddings)</text>

  <!-- query path -->
  <text x="40" y="150" font-size="13" font-weight="600" fill="var(--ink)">Query time</text>

  <rect x="40" y="162" width="150" height="54" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="115" y="185" font-size="12" text-anchor="middle" fill="var(--accent-ink)">User query</text>
  <text x="115" y="203" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">(optionally rewritten)</text>

  <line x1="194" y1="189" x2="240" y2="189" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06rag-arrow)" />

  <rect x="246" y="162" width="150" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="321" y="185" font-size="12" text-anchor="middle" fill="var(--ink)">Retriever</text>
  <text x="321" y="203" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">rank chunks by relevance</text>

  <line x1="321" y1="160" x2="321" y2="120" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="4 3" />
  <line x1="400" y1="189" x2="446" y2="189" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06rag-arrow)" />
  <text x="423" y="180" font-size="10" text-anchor="middle" fill="var(--accent)">top-k chunks</text>

  <rect x="452" y="162" width="228" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="566" y="185" font-size="12" text-anchor="middle" fill="var(--ink)">Final prompt</text>
  <text x="566" y="203" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">query + retrieved context (+ reranking)</text>

  <line x1="566" y1="216" x2="566" y2="248" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch06rag-arrow)" />

  <rect x="452" y="254" width="228" height="54" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="566" y="277" font-size="12" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">Generator</text>
  <text x="566" y="295" font-size="10.5" text-anchor="middle" fill="var(--ink-soft)">answers grounded in retrieved context</text>

  <!-- notes -->
  <rect x="40" y="254" width="380" height="110" rx="9" fill="var(--bg-raised)" stroke="var(--line)" />
  <text x="58" y="278" font-size="11.5" font-weight="600" fill="var(--ink)">Why RAG even with huge context windows:</text>
  <text x="58" y="298" font-size="10.5" fill="var(--ink-soft)">· data grows faster than context limits — and context expands to fill them</text>
  <text x="58" y="316" font-size="10.5" fill="var(--ink-soft)">· long context ≠ used well (lost-in-the-middle) — relevance beats volume</text>
  <text x="58" y="334" font-size="10.5" fill="var(--ink-soft)">· every extra token costs money and latency</text>
  <text x="58" y="352" font-size="10.5" fill="var(--ink-soft)">· per-query context = feature engineering for foundation models</text>

  <text x="360" y="404" font-size="12" font-style="italic" text-anchor="middle" fill="var(--ink-soft)">The retriever makes or breaks the system: index quality in, answer quality out.</text>
</svg>
