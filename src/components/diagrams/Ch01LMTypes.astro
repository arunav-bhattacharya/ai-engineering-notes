<svg viewBox="0 0 720 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Autoregressive versus masked language models">
  <defs>
    <marker id="ch01lm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
    </marker>
  </defs>

  <!-- ============ panel A: autoregressive ============ -->
  <text x="50" y="28" font-size="14" font-weight="550" fill="var(--ink)">Autoregressive — predict the NEXT token from what came before</text>

  <!-- arcs from context tokens to target (peaks stay below y=40) -->
  <path d="M 96 108 C 130 52, 480 52, 540 106" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 206 108 C 240 66, 470 66, 532 110" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 316 108 C 350 80, 460 80, 524 114" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 426 108 C 450 92, 470 92, 516 118" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />

  <!-- tokens -->
  <g font-size="13" text-anchor="middle">
    <rect x="50" y="110" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="96" y="133" fill="var(--ink)">My</text>
    <rect x="160" y="110" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="206" y="133" fill="var(--ink)">favorite</text>
    <rect x="270" y="110" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="316" y="133" fill="var(--ink)">color</text>
    <rect x="380" y="110" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="426" y="133" fill="var(--ink)">is</text>
    <rect x="490" y="110" width="92" height="36" rx="7" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
    <text x="536" y="133" font-weight="550" fill="var(--accent-ink)">__?</text>
  </g>
  <text x="50" y="176" font-size="12" fill="var(--ink-soft)">e.g. the GPT family · the default for text generation — it can keep producing one token after another</text>

  <!-- ============ panel B: masked ============ -->
  <text x="50" y="232" font-size="14" font-weight="550" fill="var(--ink)">Masked — fill in a blank using context from BOTH sides</text>

  <!-- arcs into the middle blank from left and right -->
  <path d="M 96 312 C 120 260, 260 260, 308 310" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 206 312 C 230 276, 280 276, 316 314" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 426 312 C 410 276, 360 276, 336 314" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />
  <path d="M 536 312 C 510 260, 380 260, 344 310" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#ch01lm-arrow)" />

  <g font-size="13" text-anchor="middle">
    <rect x="50" y="314" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="96" y="337" fill="var(--ink)">My</text>
    <rect x="160" y="314" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="206" y="337" fill="var(--ink)">favorite</text>
    <rect x="280" y="314" width="92" height="36" rx="7" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
    <text x="326" y="337" font-weight="550" fill="var(--accent-ink)">__?</text>
    <rect x="380" y="314" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="426" y="337" fill="var(--ink)">is</text>
    <rect x="490" y="314" width="92" height="36" rx="7" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="536" y="337" fill="var(--ink)">blue</text>
  </g>
  <text x="50" y="380" font-size="12" fill="var(--ink-soft)">e.g. BERT · suited to understanding tasks — classification, sentiment, code debugging</text>
</svg>
