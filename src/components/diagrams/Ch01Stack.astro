<svg viewBox="0 0 720 348" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Three layers of the AI engineering stack">
  <!-- layer 1: application development -->
  <rect x="20" y="16" width="680" height="96" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="44" y="48" font-size="15" font-weight="550" fill="var(--accent-ink)">Application development</text>
  <text x="44" y="68" font-size="11.5" fill="var(--ink-soft)">where most AI engineers work</text>
  <g font-size="11.5" text-anchor="middle" fill="var(--ink)">
    <rect x="300" y="36" width="118" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="359" y="54">Evaluation</text>
    <rect x="430" y="36" width="148" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="504" y="54">Prompt engineering</text>
    <rect x="300" y="70" width="118" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="359" y="88">AI interface</text>
    <rect x="430" y="70" width="148" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="504" y="88">Context construction</text>
  </g>

  <!-- layer 2: model development -->
  <rect x="20" y="128" width="680" height="96" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="44" y="160" font-size="15" font-weight="550" fill="var(--ink)">Model development</text>
  <text x="44" y="180" font-size="11.5" fill="var(--ink-soft)">classic ML engineering territory</text>
  <g font-size="11.5" text-anchor="middle" fill="var(--ink)">
    <rect x="300" y="148" width="148" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="374" y="166">Modeling &amp; training</text>
    <rect x="460" y="148" width="158" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="539" y="166">Dataset engineering</text>
    <rect x="300" y="182" width="180" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="390" y="200">Inference optimization</text>
    <rect x="492" y="182" width="118" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="551" y="200">Evaluation</text>
  </g>

  <!-- layer 3: infrastructure -->
  <rect x="20" y="240" width="680" height="96" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="44" y="272" font-size="15" font-weight="550" fill="var(--ink)">Infrastructure</text>
  <text x="44" y="292" font-size="11.5" fill="var(--ink-soft)">changed the least with foundation models</text>
  <g font-size="11.5" text-anchor="middle" fill="var(--ink)">
    <rect x="300" y="260" width="128" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="364" y="278">Model serving</text>
    <rect x="440" y="260" width="178" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="529" y="278">Compute &amp; data mgmt</text>
    <rect x="300" y="294" width="128" height="28" rx="14" fill="var(--bg-raised)" stroke="var(--line-strong)" />
    <text x="364" y="312">Monitoring</text>
  </g>
</svg>
