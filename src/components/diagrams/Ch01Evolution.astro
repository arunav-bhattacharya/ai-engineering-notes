<svg viewBox="0 0 720 392" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Evolution from language models to AI engineering">
  <defs>
    <marker id="ch01evo-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <!-- stage 1 -->
  <rect x="40" y="16" width="330" height="58" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="60" y="40" font-size="15" font-weight="600" fill="var(--ink)">Language models</text>
  <text x="60" y="60" font-size="12" fill="var(--ink-soft)">statistical next-token prediction · 1950s onward</text>

  <line x1="205" y1="74" x2="205" y2="106" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01evo-arrow)" />
  <text x="222" y="95" font-size="12" font-style="italic" fill="var(--accent)">scaled up via self-supervision</text>

  <!-- stage 2 -->
  <rect x="40" y="112" width="330" height="58" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="60" y="136" font-size="15" font-weight="600" fill="var(--ink)">Large language models</text>
  <text x="60" y="156" font-size="12" fill="var(--ink-soft)">no labels needed — the internet becomes training data</text>

  <line x1="205" y1="170" x2="205" y2="202" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01evo-arrow)" />
  <text x="222" y="191" font-size="12" font-style="italic" fill="var(--accent)">extended to images, audio, video…</text>

  <!-- stage 3 -->
  <rect x="40" y="208" width="330" height="58" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="60" y="232" font-size="15" font-weight="600" fill="var(--ink)">Foundation models</text>
  <text x="60" y="252" font-size="12" fill="var(--ink-soft)">multimodal, general-purpose, built to be adapted</text>

  <line x1="205" y1="266" x2="205" y2="298" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01evo-arrow)" />
  <text x="222" y="287" font-size="12" font-style="italic" fill="var(--accent)">exposed as APIs — model as a service</text>

  <!-- stage 4 -->
  <rect x="40" y="304" width="330" height="58" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="60" y="328" font-size="15" font-weight="600" fill="var(--accent-ink)">AI engineering</text>
  <text x="60" y="348" font-size="12" fill="var(--ink-soft)">building applications on top of ready-made models</text>
</svg>
