<svg viewBox="0 0 720 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Prompt decomposition: one giant prompt versus chained subtask prompts">
  <defs>
    <marker id="ch05dc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <!-- before -->
  <text x="40" y="32" font-size="13.5" font-weight="600" fill="var(--ink)">Before: one giant prompt</text>
  <rect x="40" y="44" width="640" height="64" rx="10" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="60" y="70" font-size="11.5" fill="var(--ink-soft)">“Classify the request into one of 10 intents AND follow the right one of 10 response policies AND check edge cases AND…”</text>
  <text x="60" y="92" font-size="11.5" fill="var(--ink-soft)">grows past 1,500 tokens · hard to debug · one model must do everything</text>

  <!-- after -->
  <text x="40" y="148" font-size="13.5" font-weight="600" fill="var(--ink)">After: decomposed and chained</text>

  <rect x="40" y="164" width="240" height="78" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" />
  <text x="160" y="190" font-size="12.5" font-weight="600" text-anchor="middle" fill="var(--accent-ink)">Prompt 1 · classify intent</text>
  <text x="160" y="210" font-size="11" text-anchor="middle" fill="var(--ink-soft)">small, cheap model is fine</text>
  <text x="160" y="228" font-size="11" text-anchor="middle" fill="var(--ink-soft)">output: {primary, secondary}</text>

  <line x1="284" y1="203" x2="336" y2="203" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch05dc-arrow)" />
  <text x="310" y="192" font-size="10.5" text-anchor="middle" fill="var(--accent)">route</text>

  <rect x="342" y="148" width="338" height="36" rx="8" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="511" y="171" font-size="11.5" text-anchor="middle" fill="var(--ink)">Prompt 2a · billing response policy</text>
  <rect x="342" y="192" width="338" height="36" rx="8" fill="var(--bg-inset)" stroke="var(--accent)" stroke-width="1.5" />
  <text x="511" y="215" font-size="11.5" text-anchor="middle" fill="var(--ink)">Prompt 2b · troubleshooting policy (stronger model)</text>
  <rect x="342" y="236" width="338" height="36" rx="8" fill="var(--bg-inset)" stroke="var(--line-strong)" />
  <text x="511" y="259" font-size="11.5" text-anchor="middle" fill="var(--ink)">Prompt 2c · account management policy · …</text>

  <!-- benefits -->
  <g font-size="11">
    <rect x="40" y="296" width="310" height="84" rx="9" fill="var(--bg-raised)" stroke="var(--line)" />
    <text x="58" y="319" font-weight="600" fill="var(--good-ink)">Wins</text>
    <text x="58" y="337" fill="var(--ink-soft)">· monitor &amp; debug each step in isolation</text>
    <text x="58" y="353" fill="var(--ink-soft)">· parallelize independent steps · simpler prompts</text>
    <text x="58" y="369" fill="var(--ink-soft)">· cheaper models for easier steps (GoDaddy: better + cheaper)</text>

    <rect x="370" y="296" width="310" height="84" rx="9" fill="var(--bg-raised)" stroke="var(--line)" />
    <text x="388" y="319" font-weight="600" fill="var(--warn-ink)">Costs</text>
    <text x="388" y="337" fill="var(--ink-soft)">· more model calls (though smaller each)</text>
    <text x="388" y="353" fill="var(--ink-soft)">· perceived latency grows — users wait through</text>
    <text x="388" y="369" fill="var(--ink-soft)">hidden intermediate steps before the first token</text>
  </g>
</svg>
