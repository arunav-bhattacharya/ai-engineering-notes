<svg viewBox="0 0 720 312" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Traditional ML workflow versus AI engineering workflow">
  <defs>
    <marker id="ch01wf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--ink-faint)" />
    </marker>
  </defs>

  <!-- row 1: traditional ML -->
  <text x="40" y="32" font-size="14" font-weight="600" fill="var(--ink)">Traditional ML — model first, product last</text>
  <g font-size="13.5" text-anchor="middle">
    <rect x="40" y="52" width="170" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="125" y="75" font-weight="600" fill="var(--ink)">Collect data</text>
    <text x="125" y="94" font-size="11.5" fill="var(--ink-soft)">months of labeling</text>
    <rect x="275" y="52" width="170" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="360" y="75" font-weight="600" fill="var(--ink)">Train a model</text>
    <text x="360" y="94" font-size="11.5" fill="var(--ink-soft)">specialized ML work</text>
    <rect x="510" y="52" width="170" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="595" y="75" font-weight="600" fill="var(--ink)">Build product</text>
    <text x="595" y="94" font-size="11.5" fill="var(--ink-soft)">finally, users</text>
  </g>
  <line x1="216" y1="79" x2="268" y2="79" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01wf-arrow)" />
  <line x1="451" y1="79" x2="503" y2="79" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01wf-arrow)" />

  <!-- row 2: AI engineering -->
  <text x="40" y="186" font-size="14" font-weight="600" fill="var(--ink)">AI engineering — product first, invest later</text>
  <g font-size="13.5" text-anchor="middle">
    <rect x="40" y="206" width="170" height="54" rx="9" fill="var(--accent-soft)" stroke="var(--accent)" />
    <text x="125" y="229" font-weight="600" fill="var(--accent-ink)">Build product</text>
    <text x="125" y="248" font-size="11.5" fill="var(--ink-soft)">on an existing model</text>
    <rect x="275" y="206" width="170" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="360" y="229" font-weight="600" fill="var(--ink)">Collect data</text>
    <text x="360" y="248" font-size="11.5" fill="var(--ink-soft)">if it shows promise</text>
    <rect x="510" y="206" width="170" height="54" rx="9" fill="var(--bg-inset)" stroke="var(--line-strong)" />
    <text x="595" y="229" font-weight="600" fill="var(--ink)">Improve model</text>
    <text x="595" y="248" font-size="11.5" fill="var(--ink-soft)">finetune, optimize</text>
  </g>
  <line x1="216" y1="233" x2="268" y2="233" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01wf-arrow)" />
  <line x1="451" y1="233" x2="503" y2="233" stroke="var(--ink-faint)" stroke-width="1.5" marker-end="url(#ch01wf-arrow)" />

  <text x="40" y="296" font-size="12" font-style="italic" fill="var(--ink-soft)">The order reverses: fast iteration wins, which is why full-stack instincts matter in AI engineering.</text>
</svg>
