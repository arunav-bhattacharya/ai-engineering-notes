---
import { getCollection, render } from "astro:content";
import Chapter from "../../layouts/Chapter.astro";

export async function getStaticPaths() {
  const chapters = (await getCollection("chapters")).sort(
    (a, b) => a.data.number - b.data.number,
  );
  return chapters.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: chapters[i - 1], next: chapters[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

const knowledge = import.meta.glob<{
  flashcards: unknown[];
  quiz: unknown[];
  assignments: unknown[];
}>("../../data/knowledge/*.ts", { eager: true });
const k = knowledge[`../../data/knowledge/${entry.id}.ts`];
const counts = k
  ? {
      flashcards: k.flashcards.length,
      quiz: k.quiz.length,
      assignments: k.assignments.length,
    }
  : null;
---

<Chapter
  entry={entry}
  headings={headings}
  prev={prev}
  next={next}
  counts={counts}
>
  <Content />
</Chapter>
