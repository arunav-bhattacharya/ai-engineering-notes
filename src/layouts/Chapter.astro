---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import ChapterTOC from "../components/ChapterTOC.astro";

interface Props {
  entry: CollectionEntry<"chapters">;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<"chapters">;
  next?: CollectionEntry<"chapters">;
  counts?: { flashcards: number; quiz: number; assignments: number } | null;
}

const { entry, headings, prev, next, counts } = Astro.props;
const { number, title, description, readingTime } = entry.data;
const base = import.meta.env.BASE_URL;
---

<Base
  title={`Ch ${number}: ${entry.data.shortTitle} · AI Engineering Notes`}
  description={description}
  withSidebarToggle
>
  <div class="read-progress" id="read-progress"></div>
  <div class="shell has-toc">
    <Sidebar currentSlug={entry.id} />
    <main class="content" data-pagefind-body data-chapter={entry.id}>
      <article class="prose">
        <p class="kicker">Chapter {number}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="chapter-stats">
          <span class="cs-item">
            <svg class="cs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7.5V12l3 1.8" />
            </svg>
            {readingTime} min read
          </span>
          {
            counts && (
              <>
                <span class="cs-item">
                  <svg class="cs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="7" y="3" width="14" height="14" rx="2" />
                    <path d="M3 7v12a2 2 0 0 0 2 2h12" />
                  </svg>
                  {counts.flashcards} flashcard{counts.flashcards === 1 ? "" : "s"}
                </span>
                <span class="cs-item">
                  <svg class="cs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.6 9.4a2.4 2.4 0 0 1 4.7.6c0 1.6-2.3 2-2.3 2" />
                    <path d="M12 17h.01" />
                  </svg>
                  {counts.quiz} quiz{counts.quiz === 1 ? "" : "zes"}
                </span>
                <span class="cs-item">
                  <svg class="cs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                  {counts.assignments} assignment{counts.assignments === 1 ? "" : "s"}
                </span>
              </>
            )
          }
        </p>
        <ChapterTOC headings={headings} variant="mobile" />
        <slot />
        <nav class="chapter-nav" aria-label="Chapter navigation">
          {
            prev && (
              <a href={`${base}/chapters/${prev.id}/`}>
                <span class="dir">← Previous</span>
                <span class="title">
                  {prev.data.number}. {prev.data.shortTitle}
                </span>
              </a>
            )
          }
          {
            next && (
              <a class="next" href={`${base}/chapters/${next.id}/`}>
                <span class="dir">Next →</span>
                <span class="title">
                  {next.data.number}. {next.data.shortTitle}
                </span>
              </a>
            )
          }
        </nav>
      </article>
    </main>
    <ChapterTOC headings={headings} variant="desktop" chapterNumber={number} />
  </div>

  <script>
    // top reading-progress bar + mark chapter read at 85%
    const bar = document.getElementById("read-progress");
    const main = document.querySelector<HTMLElement>("main[data-chapter]");
    const chapterId = main?.dataset.chapter;
    let marked = !!(chapterId && localStorage.getItem(`aie:read:${chapterId}`));

    const onScroll = () => {
      const total = document.documentElement.scrollHeight - innerHeight;
      const pct = total > 0 ? Math.min(scrollY / total, 1) : 0;
      if (bar) bar.style.width = `${pct * 100}%`;
      if (!marked && pct > 0.85 && chapterId) {
        localStorage.setItem(`aie:read:${chapterId}`, "1");
        marked = true;
      }
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // scroll-spy for the desktop TOC
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "#toc-list a[data-target]",
    );
    if (links.length) {
      const byId = new Map(
        [...links].map((l) => [l.dataset.target!, l] as const),
      );
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove("current"));
              byId.get(e.target.id)?.classList.add("current");
            }
          }
        },
        { rootMargin: "-15% 0px -75% 0px" },
      );
      for (const id of byId.keys()) {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      }
    }
  </script>
</Base>
