---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description?: string;
  /** show the hamburger that opens the chapter sidebar (chapter pages) */
  withSidebarToggle?: boolean;
}

const { title, description, withSidebarToggle = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,300..800&family=Google+Sans+Code:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set theme and sidebar state before first paint to avoid flash.
      (() => {
        const saved = localStorage.getItem("aie:theme");
        const theme =
          saved ??
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.dataset.theme = theme;
        if (localStorage.getItem("aie:sidebar") === "collapsed") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      {
        withSidebarToggle && (
          <button
            class="icon-btn"
            id="sidebar-toggle"
            aria-label="Open chapter list"
            aria-expanded="false"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        )
      }
      <a class="site-title" href={`${base}/`}>
        AI Engineering <span class="subtitle">· field notes on the book by Chip Huyen</span>
      </a>
      <div class="header-spacer"></div>
      <button class="icon-btn" id="search-open" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <span class="search-hint">⌘K</span>
      </button>
      <ThemeToggle />
    </header>

    <slot />

    <footer class="site-footer">
      <p>
        Independent study notes on <em>AI Engineering</em> by Chip Huyen
        (O&rsquo;Reilly, 2025). Not affiliated with the author or publisher —
        <a
          href="https://www.oreilly.com/library/view/ai-engineering/9781098166298/"
          rel="noopener">buy the book</a
        >, it&rsquo;s worth it.
      </p>
    </footer>

    <SearchModal />

    <script>
      const dialog = document.getElementById(
        "search-modal",
      ) as HTMLDialogElement | null;
      document.getElementById("search-open")?.addEventListener("click", () => {
        dialog?.showModal();
        dialog?.querySelector("input")?.focus();
      });
      addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          if (dialog?.open) dialog.close();
          else {
            dialog?.showModal();
            dialog?.querySelector("input")?.focus();
          }
        }
      });
      dialog?.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
